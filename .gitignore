# Data folders: keep the directory in Git, ignore its contents
datalake/*
!datalake/.keep

datamarts/*
!datamarts/.keep

# Control layer state files
control/*.txt

# Python caches, virtual environments and packaging
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.venv/
venv/
.env
ENV/

# Sample data can be regenerated by the downloader
sample_data/bodies/*.txt
sample_data/headers/*.txt

# Legacy index output at repository root
inverted_index.json

# Temporary and log files
*.tmp
*.log
*.swp
*~

# IDE & OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Benchmark results
src/utils/benchmarks/results/

# Multi-language build outputs
multilang_ports/**/target/
multilang_ports/**/*.o
