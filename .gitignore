# Data folders: keep the directory in Git, ignore its contents
datalake/*
!datalake/.keep

datamarts/*
!datamarts/.keep

# Control layer state files
control/*.txt

# Python caches, virtual environments and packaging
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.venv/
venv/
.env

# Logs
*.log

# Sample data can be regenerated by the downloader
sample_data/bodies/*.txt
sample_data/headers/*.txt

# Legacy index output at repository root
inverted_index.json

# Compiled ports
out/

# Experiment book source: local cache ignored, manifest tracked
data_source/*
!data_source/manifest.json

# Benchmark experiment data directories
scripts/benchmarks/results/datalake/
scripts/benchmarks/results/index/
