# Data folders: keep the directory in Git, ignore its contents
datalake/*
!datalake/.keep

datamarts/*
!datamarts/.keep

# Control layer state files
control/*.txt

# Python caches, virtual environments and packaging
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.venv/
venv/
.env
ENV/

# Legacy index output at repository root
inverted_index.json

# Temporary and log files
*.tmp
*.log
*.swp
*~

# IDE & OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Experiment book source: local cache ignored except the tracked corpus
data_source/*
!data_source/manifest.json
!data_source/bodies/
!data_source/headers/

# Benchmark results: regenerated by every run, published as dated snapshots in docs/results/
src/utils/benchmarks/results/

# Multi-language build outputs
multilang_ports/**/target/
multilang_ports/**/*.o
multilang_ports/go/results/
multilang_ports/go/output/
